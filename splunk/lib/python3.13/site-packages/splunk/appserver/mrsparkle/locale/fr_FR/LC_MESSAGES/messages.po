#: default/searchbnf.conf.in:1641 
msgid ""
"Extraction options. \\\n"
"\"segment\"    specifies whether to note the locations of key/value pairs"
" with the results (internal, false). \\\n"
"\"reload\"     specifies whether to force reloading of props.conf and "
"transforms.conf (false). \\\n"
"\"kvdelim\"    string specifying a list of character delimiters that "
"separate the key from the value \\\n"
"\"pairdelim\"  string specifying a list of character delimiters that "
"separate the key-value pairs from each other \\\n"
"\"maxchars\"   specifies how many characters to look into the event "
"(10240). \\\n"
"\"mv_add\"     whether to create multivalued fields. Overrides MV_ADD "
"from transforms.conf \\\n"
"\"clean_keys\" whether to clean keys. Overrides CLEAN_KEYS from "
"transforms.conf \\\n"
"\"keep_empty_vals\" whether to keep KV pairs with empty values. Overrides"
" KEEP_EMPTY_VALS from transforms.conf"
msgstr ""
"Options d’extraction. \\\n"
"\"segment\"    spécifie s’il convient de noter les emplacements de paires clé/valeur avec les résultats (internal, false). \\\n"
"\"reload\"     spécifie s’il convient de forcer le rechargement de props.conf et transforms.conf (false). \\\n"
"\"kvdelim\"    chaîne spécifiant une liste de délimiteurs de caractères qui séparent la clé de la valeur \\\n"
"\"pairdelim\"  chaîne spécifiant une liste de délimiteurs de caractères qui séparent les paires clé-valeur les unes des autres \\\n"
"\"maxchars\"   spécifie combien de caractères rechercher dans l’événement (10240). \\\n"
"\"mv_add\"     s’il convient de créer des champs à valeurs multiples. Remplace MV_ADD depuis transforms.conf \\\n"
"\"clean_keys\" s’il convient de nettoyer les clés. Remplace CLEAN_KEYS de transforms.conf \\\n"
"\"keep_empty_vals\" s’il convient de conserver les paires KV avec des valeurs vides. Remplace KEEP_EMPTY_VALS de transforms.conf"

