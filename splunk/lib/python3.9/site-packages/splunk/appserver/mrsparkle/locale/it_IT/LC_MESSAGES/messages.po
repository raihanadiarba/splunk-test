#: default/searchbnf.conf.in:3130 
msgid ""
"Export all events from the index \"bigdata\" to the location "
"\"YYYYmmdd/HH/host\" \\\n"
"at the \"$SPLUNK_HOME/var/run/splunk/dispatch/&lt;sid&gt;/dump/\" "
"directory on local disk with \"MyExport\" \\\n"
"as the prefix of export filenames. Partitioning of the export data is "
"achieved by eval preceding the dump command."
msgstr ""
"Esporta tutti gli eventi dall'indice \"bigdata\" alla posizione \"YYYYmmdd/HH/host\" \\\n"
